---
# The checks starting with - are disabled. Most of them because we do not need/want them,
# but following warnings are disabled as they cause errors or false warnings in our code.
# Causes clang-tidy-12 internal segfaults:
# -readability-static-accessed-through-instance
# Gives warning in dune-alugrid/dune/alugrid/3d/grid_inline.hh:49:20 for dune/xt/test/grid/dgf_gridprovider.cc:
# Call to virtual method ALU3dGrid::createALUGrid during construction bypasses virtual dispatch
# -clang-analyzer-optin.cplusplus.VirtualCall,
# Gives false positives, see https://github.com/llvm/llvm-project/issues/40486 and https://bugs.llvm.org/show_bug.cgi?id=44247
# -clang-analyzer-cplusplus.NewDeleteLeaks,
# These cause a lot of warnings for static inline functions in headerchecks because they are not used in that compilation unit
# -clang-diagnostic-unneeded-internal-declaration
# -clang-diagnostic-unused-function
# Enable whole check families rather than an allow-list, then subtract what does not fit a
# template-heavy numerics library. Families deliberately left off: cppcoreguidelines-* (its
# pro-bounds/pro-type/magic-number checks fire on essentially every numerical kernel), and the
# vendor/alias families (google-*, llvm-*, hicpp-*, cert-*, fuchsia-*, abseil-*, altera-*, ...)
# which either duplicate the checks below under different names or encode a foreign house style.
#
# The second block of exclusions is the historical one: checks this project has deliberately
# opted out of for years.
#
# The third block was chosen by measurement, not taste -- one run over dune/xt/common (58 files)
# produced 1675 findings, and these nine checks accounted for 1085 of them. Each fires on
# idiomatic code in this domain and would bury the findings that matter:
#   readability-identifier-length (449)    i, j, dd, rr are the vocabulary of the field
#   readability-braces-around-statements (235)  single-statement bodies are the house style
#   misc-include-cleaner (193)             IWYU-style include hygiene is its own project
#   modernize-use-constraints (76)         rewriting SFINAE as requires-clauses is not mechanical
#   readability-function-cognitive-complexity (32)  numerical kernels are irreducibly branchy
#   misc-const-correctness (31)            mass const insertion, little signal
#   bugprone-narrowing-conversions (26)    size_t/int/floating conversions are pervasive, deliberate
#   bugprone-easily-swappable-parameters (18)  unavoidable for (x, y, z) style numerical APIs
#   readability-magic-numbers              quadrature orders, tolerances, dimensions
Checks: '-*,
         bugprone-*,
         clang-analyzer-*,
         concurrency-*,
         misc-*,
         modernize-*,
         performance-*,
         portability-*,
         readability-*,

         -bugprone-macro-parentheses,
         -bugprone-reserved-identifier,
         -misc-no-recursion,
         -misc-non-private-member-variables-in-classes,
         -misc-throw-by-value-catch-by-reference,
         -misc-unconventional-assign-operator,
         -modernize-use-nodiscard,
         -modernize-use-noexcept,
         -modernize-use-trailing-return-type,
         -readability-redundant-string-init,
         -readability-static-accessed-through-instance,
         -clang-analyzer-cplusplus.NewDeleteLeaks,
         -clang-analyzer-optin.cplusplus.VirtualCall,
         -clang-diagnostic-unneeded-internal-declaration,
         -clang-diagnostic-unused-function,

         -readability-identifier-length,
         -readability-braces-around-statements,
         -misc-include-cleaner,
         -modernize-use-constraints,
         -readability-function-cognitive-complexity,
         -misc-const-correctness,
         -bugprone-narrowing-conversions,
         -bugprone-easily-swappable-parameters,
         -readability-magic-numbers'

WarningsAsErrors: ''
# dune-xt and dune-gdt live in one repository now, as <root>/{dune,python}/{xt,gdt}; the
# pre-merge dune-xt-super layout this used to match no longer exists anywhere. The tidy
# targets additionally pass an absolute -header-filter anchored at the source dir, which
# takes precedence; this value is what editors and clangd pick up.
HeaderFilterRegex: '.*/(dune|python)/(xt|gdt)/.*'
# Vendored third-party headers: the math expression parser (Copyright Yann Ollivier) and
# the bundled GoogleTest are upstream concerns.
ExcludeHeaderFilterRegex: '.*/(mathexpr\.hh|test/gtest/.*)'
FormatStyle:     file
CheckOptions:
  - key:             cert-dcl16-c.NewSuffixes
    value:           'L;LL;LU;LLU'
  - key:             cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value:           '1'
  - key:             google-readability-braces-around-statements.ShortStatementLines
    value:           '1'
  - key:             google-readability-function-size.StatementThreshold
    value:           '800'
  - key:             google-readability-namespace-comments.ShortNamespaceLines
    value:           '10'
  - key:             google-readability-namespace-comments.SpacesBeforeComments
    value:           '2'
  - key:             modernize-loop-convert.MaxCopySize
    value:           '16'
  - key:             modernize-loop-convert.MinConfidence
    value:           reasonable
  - key:             modernize-loop-convert.NamingStyle
    value:           CamelCase
  - key:             modernize-pass-by-value.IncludeStyle
    value:           llvm
  - key:             modernize-replace-auto-ptr.IncludeStyle
    value:           llvm
  - key:             modernize-use-nullptr.NullMacros
    value:           'NULL'
...
