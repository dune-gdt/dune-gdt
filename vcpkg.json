{
  "name": "dune-gdt",
  "version-string": "0.1.0",
  "description": "DUNE Generic Discretization Toolbox",
  "homepage": "https://github.com/dune-gdt/dune-gdt",
  "features": {
    "uggrid": {
      "description": "Enable UGGrid support",
      "dependencies": [
        {
          "name": "dune-uggrid"
        },
        {
          "name": "dune-grid",
          "features": [
            "uggrid"
          ]
        }
      ]
    },
    "alberta": {
      "description": "Enable Alberta grid support",
      "dependencies": [
        {
          "name": "dune-grid",
          "features": [
            "alberta"
          ]
        }
      ]
    },
    "gmsh": {
      "description":
        "Build the gmsh CLI (docs build only: pymor's discretize_gmsh shells out to it for the gmsh tutorial notebook, see .vcpkg-overlays/README.md)",
      "dependencies": [
        "gmsh"
      ]
    }
  },
  "dependencies": [
    "dune-common",
    "dune-geometry",
    "dune-grid",
    "dune-istl",
    "dune-localfunctions",
    "dune-testtools",
    "dune-alugrid",
    "dune-grid-glue",
    "pybind11",
    "boost-core",
    "boost-assign",
    "boost-atomic",
    "boost-accumulators",
    "boost-chrono",
    "boost-date-time",
    "boost-filesystem",
    "boost-system",
    "boost-thread",
    "boost-format",
    "boost-serialization",
    "boost-timer",
    "exprtk",
    "gtest",
    "nanobench",
    "eigen3",
    "tbb",
    {
      "name": "openblas",
      "features": [
        "dynamic-arch"
      ],
      "platform": "!windows | mingw"
    },
    {
      "name": "openblas",
      "platform": "windows & !mingw"
    },
    "suitesparse",
    "lapack"
  ],
  "builtin-baseline": "d015e31e90838a4c9dfa3eed45979bc70d9357fc",
  "overrides": [
    {
      "name": "eigen3",
      "version": "3.4.0",
      "port-version": 5
    }
  ]
}
